{
  "name": "idx-risk-radar",
  "version": "0.1.0",
  "description": "Data-only risk screening for Indonesian (IDX) stocks from TradingView Desktop, with walk-forward-tested ML ranking, trade levels drawn on the chart, a beginner dashboard, and an MCP server for Claude.",
  "type": "module",
  "main": "src/server.js",
  "bin": { "idx-risk-radar": "src/server.js" },
  "scripts": {
    "start": "node src/server.js",
    "start:http": "node src/server.js --http",
    "postinstall": "patch-package",
    "fetch": "node quant/fetch.mjs",
    "model": "node quant/model.mjs quant/data/daily.json --out quant/data/model.json",
    "draw": "node quant/draw.mjs all",
    "dashboard": "node quant/build-radar.mjs",
    "radar": "npm run fetch && npm run model && npm run dashboard",
    "launch": "node node_modules/tradingview-mcp/src/cli/index.js launch",
    "test": "node --test test/model.test.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "patch-package": "^8.0.0",
    "tradingview-mcp": "github:tradesdontlie/tradingview-mcp#c05b8f5",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/nopraalgusduri12-blip/idx-risk-radar.git" },
  "homepage": "https://github.com/nopraalgusduri12-blip/idx-risk-radar"
}
