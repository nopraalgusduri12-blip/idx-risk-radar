{
  "name": "idx-risk-radar",
  "version": "0.3.0",
  "description": "Data-only risk screening for Indonesian (IDX) stocks: quant + ML risk engine on TradingView data, a web dashboard and API you can open from any device, and an MCP server for Claude (local or claude.ai custom connector).",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "idx-risk-radar": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "postinstall": "patch-package",
    "fetch": "node quant/fetch.mjs",
    "model": "node quant/model.mjs quant/data/daily.json --out quant/data/model.json",
    "draw": "node quant/draw.mjs all",
    "risk": "node quant/risk.mjs quant/data/daily.json quant/data/model.json --out quant/data/risk.json",
    "dashboard": "node quant/build-radar.mjs",
    "radar": "npm run fetch && npm run model && npm run risk && npm run daytrade && npm run dashboard",
    "launch": "node node_modules/tradingview-mcp/src/cli/index.js launch",
    "test": "node --test test/model.test.js test/lib.test.js test/web.test.js",
    "web": "node src/web.js",
    "collect": "node quant/collect.mjs",
    "collect:draw": "node quant/collect.mjs --draw",
    "collect:server": "node quant/collect.mjs --server-compute",
    "web:local": "node --env-file=.env.local src/web.js",
    "daytrade": "node quant/daytrade.mjs quant/data/daily.json quant/data/risk.json --out quant/data/daytrade.json",
    "morning": "node quant/fetch.mjs --update && node quant/daytrade.mjs quant/data/daily.json quant/data/risk.json --out quant/data/daytrade.json && node quant/build-radar.mjs",
    "collect:morning": "node quant/collect.mjs --morning"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "patch-package": "^8.0.0",
    "tradingview-mcp": "github:tradesdontlie/tradingview-mcp#c05b8f5",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nopraalgusduri12-blip/idx-risk-radar.git"
  },
  "homepage": "https://github.com/nopraalgusduri12-blip/idx-risk-radar"
}
